{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gully.app/schemas/tracking/project-status.json",
  "title": "Project Status Schema",
  "description": "Machine-readable project state tracking current phase, tasks, and progress",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "lastUpdated", "project", "currentPhase", "currentTask", "phases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "project": {
      "type": "object",
      "required": ["name", "techSpecRef", "projectPlanRef"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "techSpecRef": {
          "type": "string",
          "description": "Path to TECH_SPEC.json"
        },
        "projectPlanRef": {
          "type": "string",
          "description": "Path to PROJECT_PLAN.json"
        }
      }
    },
    "currentPhase": {
      "type": "object",
      "required": ["id", "name", "status", "startDate", "progress"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P\\d+$",
          "description": "Phase ID (e.g., P2)"
        },
        "name": {
          "type": "string",
          "description": "Phase name (e.g., User Profiles)"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "complete", "blocked"],
          "description": "Current phase status"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Phase start date (YYYY-MM-DD)"
        },
        "progress": {
          "type": "object",
          "required": ["tasksComplete", "tasksTotal", "percentComplete"],
          "properties": {
            "tasksComplete": {
              "type": "integer",
              "minimum": 0
            },
            "tasksTotal": {
              "type": "integer",
              "minimum": 0
            },
            "percentComplete": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "currentTask": {
      "type": "object",
      "required": ["id", "title", "status", "dependencies", "allDependenciesComplete", "blockers"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P\\d+-[A-Z]+-T\\d+$",
          "description": "Task ID (e.g., P2-PROF-T3)"
        },
        "title": {
          "type": "string",
          "description": "Task title"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "complete", "blocked"],
          "description": "Current task status"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P\\d+-[A-Z]+-T\\d+$"
          },
          "description": "List of task IDs this task depends on"
        },
        "allDependenciesComplete": {
          "type": "boolean",
          "description": "Whether all dependencies are complete"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "severity"],
            "properties": {
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "bugId": {
                "type": "string",
                "pattern": "^BUG-\\d+$"
              }
            }
          },
          "description": "List of blockers preventing task execution"
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "startDate", "tasks", "tests", "coverage"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P\\d+$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "complete", "blocked"]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "completionDate": {
            "type": ["string", "null"],
            "format": "date"
          },
          "tasks": {
            "type": "object",
            "required": ["complete", "total"],
            "properties": {
              "complete": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "tests": {
            "type": "object",
            "required": ["passing", "total"],
            "properties": {
              "passing": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "coverage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Test coverage percentage"
          },
          "maturityGate": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["not_checked", "passed", "failed"]
              },
              "verifiedDate": {
                "type": ["string", "null"],
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
