{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gully.app/schemas/tracking/bug-tracker.json",
  "title": "Bug Tracker Schema",
  "description": "Comprehensive bug tracking with discovery, resolution, and prevention learning",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "lastUpdated", "bugs", "stats"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "severity", "priority", "status", "category", "discoveredIn"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BUG-\\d+$",
            "description": "Unique bug ID"
          },
          "title": {
            "type": "string",
            "description": "Short bug title"
          },
          "description": {
            "type": "string",
            "description": "Detailed bug description"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Bug severity level"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "Bug priority"
          },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "wont_fix", "duplicate"],
            "description": "Current bug status"
          },
          "category": {
            "type": "string",
            "enum": ["testing", "types", "database", "performance", "security", "architecture", "configuration", "dependency", "logic", "other"],
            "description": "Bug category"
          },
          "discoveredIn": {
            "type": "object",
            "required": ["date"],
            "properties": {
              "taskId": {
                "type": ["string", "null"],
                "pattern": "^P\\d+-[A-Z]+-T\\d+(\\.\\d+-[a-z]+)?$",
                "description": "Task where bug was discovered"
              },
              "phaseId": {
                "type": ["string", "null"],
                "pattern": "^P\\d+$",
                "description": "Phase where bug was discovered"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "resolution": {
            "type": ["object", "null"],
            "required": ["approach", "resolvedDate"],
            "properties": {
              "approach": {
                "type": "string",
                "description": "How the bug was resolved"
              },
              "rationale": {
                "type": "string",
                "description": "Why this resolution approach was chosen"
              },
              "resolvedDate": {
                "type": "string",
                "format": "date-time"
              },
              "resolvedBy": {
                "type": "string",
                "description": "Who/what resolved the bug (agent, human, etc.)"
              },
              "tokenCost": {
                "type": "integer",
                "minimum": 0,
                "description": "Token cost to resolve bug"
              },
              "timeCost": {
                "type": "string",
                "description": "Time cost to resolve bug"
              }
            }
          },
          "impact": {
            "type": "object",
            "properties": {
              "blocksTask": {
                "type": "boolean",
                "default": false
              },
              "blocksPhase": {
                "type": "boolean",
                "default": false
              },
              "affectedTests": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "relatedBugs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^BUG-\\d+$"
            },
            "description": "Related or duplicate bugs"
          },
          "workaround": {
            "type": ["string", "null"],
            "description": "Temporary workaround before resolution"
          },
          "prevention": {
            "type": ["string", "null"],
            "description": "Learning to prevent similar bugs in future"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags for filtering and searching"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["total", "open", "resolved"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "bySeverity": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "avgResolutionTime": {
          "type": "string",
          "description": "Average time to resolve bugs"
        },
        "totalTokenCost": {
          "type": "integer",
          "minimum": 0,
          "description": "Total tokens spent resolving bugs"
        }
      }
    }
  }
}
