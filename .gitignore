################################################################################
# GITIGNORE STRUCTURE
################################################################################
# This is the PRIMARY .gitignore for the entire Gully project.
#
# Service-specific .gitignore files should ONLY contain patterns unique to
# that service. Common patterns (node_modules, .env, IDE files) belong here.
#
# To debug which .gitignore is ignoring a file:
#   git check-ignore -v path/to/file
################################################################################

# macOS
*.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# Environment Variables
.env
.env.local
.env.*.local

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Build Output
dist/
build/
*.tsbuildinfo
*.js.map

# Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# Database Files (SQLite, etc.)
*.sqlite
*.sqlite3
*.db

# Temporary Files
tmp/
temp/
*.tmp
