{
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(cat:*)",
      "Bash(npx eslint:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ]
  }
}
