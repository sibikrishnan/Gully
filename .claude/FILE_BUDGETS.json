  "total_claude_budget": {
    "max_tokens": 5000,
    "current_estimate": 3500,
    "target": "ACHIEVED: Reduced .claude/ from 19k to ~3.5k tokens (82% reduction)"
  },
  "cost_awareness": {
    "warning": "Every file in .claude/ loads at EVERY session startup",
    "calculation": "1,000 lines = ~3k tokens × N sessions = significant cost",
    "rule": "Ask: Does this NEED to be in .claude/? If NO → move to docs/"
  },
  "enforcement_levels": {
    "strict": {
      "description": "BLOCK write if over budget - these files load every session",
      "action": "Reject write, show budget violation, suggest condensing or moving to docs/",
      "applies_to": ".claude/* files (agents, commands, hooks, skills)"
    },
    "warn": {
      "description": "WARN if over budget - on-demand files, less critical",
      "action": "Show warning, allow write, suggest optimization",
      "applies_to": "docs/* files (context, guides, planning)"
    },
    "none": {
      "description": "No enforcement - historical/archived content",
      "action": "No validation performed",
      "applies_to": "docs/archives/**"
    }
  },
  "skill_integration": {
    "skill_name": "budget-checker",
    "location": ".claude/skills/budget-checker.md",
    "usage": "ALWAYS invoke before Write/Edit on .claude/* or docs/* files",
    "workflow": [
      "1. Skill validates file path against budgets",
      "2. Counts lines in proposed content",
      "3. If strict + over budget → BLOCK with error message",
      "4. If warn + over budget → WARN but allow",
      "5. Suggests condensing strategies if needed"
    ]
  },
  "condensing_strategies": {
    "commands": [
      "Remove examples (move to docs/commands/)",
      "Remove verbose help (keep 1-line description)",
      "Remove comments, keep only executable logic"
    ],
    "agents": [
      "Remove background/context (move to docs/agents/)",
      "Keep only operational instructions",
      "Use bullet points, remove prose"
    ],
    "sessions": [
      "Use /gullycondense to auto-condense to 50 lines",
      "Extract patterns to context files",
      "Move detailed logs to docs/archives/"
    ],
    "context": [
      "Use tables instead of prose",
      "Compress examples to minimal forms",
      "Link to detailed docs instead of embedding"
    ]
  }
