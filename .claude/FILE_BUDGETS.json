  "path_rules": {
    "forbidden_patterns": [
      "/backend/docs/",
      "/backend/.claude/",
      "/.claude/schemas/",
      "/.claude/context/"
    ],
    "required_locations": {
      "docs": "/Users/sibikrishnan/Documents/Gully/docs/",
      "context": "/Users/sibikrishnan/Documents/Gully/docs/context/",
      "claude": "/Users/sibikrishnan/Documents/Gully/.claude/"
